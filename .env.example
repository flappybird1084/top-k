# Template — copy to .env and fill locally. .env is gitignored; never commit real keys.
# NOTE: .env syntax is KEY='' (dotenv does not parse "KEY: ''").
ANTHROPIC_API_KEY=''
OPENAI_API_KEY=''
WANDB_API_KEY=''
WANDB_ENTITY=''
WANDB_PROJECT=''
WEAVE_PROJECT=''
WANDB_INFERENCE_BASE_URL=''
WANDB_INFERENCE_API_KEY=''
WANDB_INFERENCE_PROJECT=''
KERNELEVO_PROFILE=''
# SearXNG instance for planner web search (needs formats: [html, json] enabled)
SEARXNG_URL=''

# --- Public gateway (judges_server.py). Server-side only: never copy any of
# --- these into the static website, the Worker source, or a job payload.
# Shared secret the Cloudflare Worker sends as X-TopK-Edge-Auth. Without it the
# gateway refuses every request, so edge and origin are configured together.
JUDGES_EDGE_SECRET=''
JUDGES_EXPIRES_AT=''
JUDGES_ORIGIN=''
# Where per-user notebook/W&B settings are stored (mode 0700, hashed filenames).
JUDGES_INTEGRATION_DIR=''
# GitHub OAuth app. The client secret belongs here and nowhere else.
GITHUB_CLIENT_ID=''
GITHUB_CLIENT_SECRET=''
GITHUB_AUTH_ORIGIN=''
GITHUB_AUTH_DB=''
